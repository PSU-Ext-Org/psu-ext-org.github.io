---
interface Props {
  id?: string;
}

const { id = 'G-89V1WNJVCM' } = Astro.props;
---

<!-- Google tag (gtag.js) -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
<script define:vars={{ id }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());

  gtag('config', id);
</script>
