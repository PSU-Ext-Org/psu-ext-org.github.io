---
import { links } from '../data/links';

const repos = [
  { name: 'Hardware', desc: 'KiCad schematics, PCB layout, and housing', href: links.repos.hardware },
  { name: 'Firmware', desc: 'ESP-IDF application running on the ESP32-S3', href: links.repos.firmware },
  { name: 'Software', desc: 'Backend proxy and the React operator dashboard', href: links.repos.software },
  { name: 'Common', desc: 'Shared definitions and resources used across the project', href: links.repos.common },
];
---

<section id="open-source" class="bg-slate-50 py-14">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Open Source</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
      PSU-EXT is open across the hardware, firmware, backend, and frontend. The core materials
      are available now in the project GitHub organization.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        repos.map((r) => (
          <a
            href={r.href}
            class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 transition hover:border-teal-300"
          >
            <div>
              <p class="font-semibold text-slate-900">{r.name}</p>
              <p class="mt-1 text-sm text-slate-600">{r.desc}</p>
            </div>
            <span class="rounded-full bg-teal-50 px-3 py-1 text-xs font-medium text-teal-700">
              View repo →
            </span>
          </a>
        ))
      }
    </div>

    <a
      href={links.githubOrg}
      class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800"
    >
      View the GitHub organization →
    </a>
  </div>
</section>
