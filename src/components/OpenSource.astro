---
import { links } from '../data/links';
---

<section id="open-source" class="bg-slate-50 py-14">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Open Source</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
      PSU-EXT is open across the hardware, firmware, backend, and frontend. The core materials
      are available now in the project GitHub organization.
    </p>

    <a
      href={links.githubOrg}
      class="group mt-10 flex max-w-md items-center justify-between rounded-xl border border-slate-200 bg-white p-5 transition hover:border-teal-300"
    >
      <div>
        <p class="font-semibold text-slate-900">PSU-Ext-Org</p>
        <p class="mt-1 text-sm text-slate-600">Browse all our repositories on GitHub</p>
      </div>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-500 group-hover:bg-teal-50 group-hover:text-teal-700">
        View on GitHub →
      </span>
    </a>
  </div>
</section>
