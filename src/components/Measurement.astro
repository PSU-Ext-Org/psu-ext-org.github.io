---
import { Image } from 'astro:assets';
import { links } from '../data/links';
import dashboardWidgets from '../assets/images/gui/dashboard-live-widgets.png';
import dashboardProtection from '../assets/images/gui/dashboard-protection-triggers.png';
import scpiConsole from '../assets/images/gui/scpi-console.png';

const items = [
  'Browser-based operator interface for control, telemetry, and configuration',
  'Live voltage, current, and power widgets with local-history charts',
  'Protection widgets for OVP/OCP thresholds and state',
  'Built-in SCPI console with device selection and tagged logs',
  'Backend proxy for browser-safe access to USB CDC and TCP SCPI devices',
];

const gallery = [
  { src: dashboardWidgets, alt: 'PSU-EXT dashboard showing live CH1 output, voltage, and current widgets with a real-time current trend chart', caption: 'Live telemetry widgets' },
  { src: dashboardProtection, alt: 'PSU-EXT dashboard showing OVP protection controls, external trigger configuration, and a timer queue', caption: 'Protection, triggers, and timers' },
  { src: scpiConsole, alt: 'PSU-EXT built-in SCPI console showing raw WebSocket traffic and a command input field', caption: 'Built-in SCPI console' },
];
---

<section id="measurement" class="py-14">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">02 &mdash; Software</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Software for Measurements</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
      A browser dashboard for watching and controlling a session live &mdash; voltage, current,
      and power widgets, protection state, and a built-in SCPI console, all backed by a
      browser-safe proxy to the device.
    </p>

    <div class="mt-10 rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
      <ul class="grid gap-x-8 gap-y-2 text-sm leading-relaxed text-slate-600 sm:grid-cols-2">
        {
          items.map((item) => (
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        gallery.map((g) => (
          <figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <button
              type="button"
              data-lightbox={g.src.src}
              data-lightbox-alt={g.alt}
              aria-label={`View larger: ${g.caption}`}
              class="group relative block w-full cursor-zoom-in"
            >
              <Image src={g.src} alt={g.alt} width={700} densities={[1, 2]} class="w-full transition group-hover:opacity-90" />
              <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-slate-950/0 transition group-hover:bg-slate-950/10">
                <span class="rounded-full bg-slate-950/70 p-2 text-white opacity-0 transition group-hover:opacity-100">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm10 17-5.5-5.5M9 11h4M11 9v4" />
                  </svg>
                </span>
              </span>
            </button>
            <figcaption class="border-t border-slate-200 px-4 py-3 text-sm font-medium text-slate-600">
              {g.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-8">
      <a
        href={links.repos.firmware}
        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-teal-300 hover:text-teal-700"
      >
        View Full Specs &amp; SCPI Reference
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>
