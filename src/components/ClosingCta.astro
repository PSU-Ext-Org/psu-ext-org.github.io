---
import { links } from '../data/links';
---

<section class="bg-teal-700 py-12 text-white">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
      Keep the PSU You Already Own &mdash; Add the Rest
    </h2>
    <p class="mt-3 text-teal-50">
      Get notified the moment the PSU-EXT campaign goes live on Crowd Supply.
    </p>
    <a
      href={links.crowdSupply}
      class="mt-6 inline-block rounded-lg bg-white px-6 py-3 text-sm font-semibold text-teal-700 shadow-sm transition hover:bg-teal-50"
    >
      Get Notified on Crowd Supply
    </a>
  </div>
</section>
