---
import CrowdSupplyButton from './CrowdSupplyButton.astro';
---

<section class="bg-teal-700 py-12 text-white">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
      Keep the PSU You Already Own &mdash; Add the Rest
    </h2>
    <p class="mt-3 text-teal-50">
      Follow PSU-EXT on Crowd Supply to receive campaign updates and be notified when we launch.
    </p>
    <div class="mt-6">
      <CrowdSupplyButton variant="inverted" />
    </div>
  </div>
</section>
