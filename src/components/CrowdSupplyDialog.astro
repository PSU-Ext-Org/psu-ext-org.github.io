---
import { links } from '../data/links';
---

<dialog
  id="crowd-supply-dialog"
  aria-labelledby="crowd-supply-dialog-title"
  aria-describedby="crowd-supply-dialog-description"
  class="m-auto w-[calc(100%_-_2rem)] max-w-lg rounded-2xl bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70"
>
  <div class="relative p-6 sm:p-8">
    <button
      id="crowd-supply-dialog-close"
      type="button"
      aria-label="Close dialog"
      class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">Crowd Supply</p>
    <h2 id="crowd-supply-dialog-title" class="mt-2 pr-10 text-2xl font-bold tracking-tight">
      Our Pre-Launch Page Is Coming Soon
    </h2>
    <p id="crowd-supply-dialog-description" class="mt-4 leading-relaxed text-slate-600">
      Thanks for your interest in PSU-EXT! We’re working hard to get our Crowd Supply
      pre-launch campaign page live. In the meantime, we’d love to hear from you—please leave
      a comment on our YouTube teaser video. Your feedback and support are very important to us.
    </p>
    <div class="mt-6 flex justify-end">
      <a
        href={links.teaserVideo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-lg bg-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
      >
        Watch the Teaser on YouTube
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('crowd-supply-dialog') as HTMLDialogElement | null;
  const closeButton = document.getElementById('crowd-supply-dialog-close');
  let previouslyFocused: HTMLElement | null = null;

  function openDialog() {
    if (!dialog || dialog.open) return;
    previouslyFocused = document.activeElement as HTMLElement | null;
    dialog.showModal();
    document.body.classList.add('overflow-hidden');
  }

  function closeDialog() {
    if (dialog?.open) dialog.close();
  }

  document.querySelectorAll<HTMLElement>('[data-crowd-supply-dialog]').forEach((trigger) => {
    trigger.addEventListener('click', openDialog);
  });

  closeButton?.addEventListener('click', closeDialog);

  dialog?.addEventListener('click', (event) => {
    const bounds = dialog.getBoundingClientRect();
    const clickedOutside =
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom;

    if (clickedOutside) closeDialog();
  });

  dialog?.addEventListener('close', () => {
    document.body.classList.remove('overflow-hidden');
    if (previouslyFocused?.isConnected && previouslyFocused.getClientRects().length > 0) {
      previouslyFocused.focus();
    } else {
      document.getElementById('nav-toggle')?.focus();
    }
    previouslyFocused = null;
  });
</script>
