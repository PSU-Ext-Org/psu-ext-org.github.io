---
import { Image } from 'astro:assets';
import pcbRender from '../assets/images/renders/psu-ext-pcb-top-view.jpg';
import { links } from '../data/links';
---

<section id="top" class="overflow-hidden bg-gradient-to-b from-teal-50 via-lime-50/40 to-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-12 md:grid-cols-2 md:py-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">
        MaxEELabs &middot; Bench Instrumentation
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Upgrade the PSU Already on Your Bench
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        PSU-EXT is an inline hardware module and software stack that adds remote control,
        protection features, live telemetry, and interactive dashboards to a conventional
        bench power supply &mdash; no replacement instrument required.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={links.crowdSupply}
          class="rounded-lg bg-teal-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-800"
        >
          Get Notified on Crowd Supply
        </a>
        <a
          href="#hardware"
          class="rounded-lg border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-teal-300 hover:text-teal-700"
        >
          See the Hardware
        </a>
      </div>
      <a
        href={links.demoVideo}
        class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-teal-700 hover:text-teal-800"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d="M8 5v14l11-7Z" /></svg>
        Working EVT-stage prototype &mdash; watch it in action
      </a>
      <dl class="mt-8 grid grid-cols-3 gap-6 border-t border-slate-200 pt-6 text-sm">
        <div>
          <dt class="text-slate-500">Measures</dt>
          <dd class="font-semibold text-slate-900">0&ndash;25 V / 0&ndash;2.5 A</dd>
        </div>
        <div>
          <dt class="text-slate-500">Control</dt>
          <dd class="font-semibold text-slate-900">SCPI over USB &amp; TCP</dd>
        </div>
        <div>
          <dt class="text-slate-500">Footprint</dt>
          <dd class="font-semibold text-slate-900">100 &times; 50 mm</dd>
        </div>
      </dl>
    </div>

    <div class="relative">
      <button
        type="button"
        data-lightbox={pcbRender.src}
        data-lightbox-alt="PSU-EXT board render, top view, Rev 1.2.0, showing the ESP32-S3 module, banana jack terminals, and USB-C connector"
        aria-label="View larger image"
        class="group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl shadow-xl ring-1 ring-slate-900/10"
      >
        <Image
          src={pcbRender}
          alt="PSU-EXT board render, top view, Rev 1.2.0, showing the ESP32-S3 module, banana jack terminals, and USB-C connector"
          width={900}
          densities={[1, 2]}
          class="w-full transition group-hover:opacity-90"
        />
        <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-slate-950/0 transition group-hover:bg-slate-950/10">
          <span class="rounded-full bg-slate-950/70 p-2 text-white opacity-0 transition group-hover:opacity-100">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm10 17-5.5-5.5M9 11h4M11 9v4" />
            </svg>
          </span>
        </span>
      </button>
    </div>
  </div>
</section>
